# Copy to .env and supply a unique password of 12–128 characters before first start.
KIDA_ADMIN_PASSWORD=
# Public HTTPS origin served by LynxEngine (no trailing slash).
KIDA_ALLOWED_ORIGINS=https://kida.example.com
KIDA_COOKIE_SECURE=true
# Development only: false, with http://127.0.0.1:4200 as allowed origin.
# KIDA_DATABASE_PATH=/absolute/path/to/auth.sqlite3
